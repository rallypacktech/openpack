{
  "name": "CacheItem",
  "type": "object",
  "properties": {
    "cache_id": {
      "type": "string",
      "description": "Reference to EmergencyCache"
    },
    "item_name": {
      "type": "string"
    },
    "quantity": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "water",
        "food",
        "medical",
        "tools",
        "clothing",
        "documents",
        "communication",
        "hygiene",
        "safety_equipment",
        "other"
      ]
    },
    "expiration_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Free-form tags for this item. \"first_aid\" marks a first aid supply \u2014 a tag on an ordinary cache item, never a cache of its own."
    },
    "recommendation_id": {
      "type": "string",
      "description": "Reference to the ProductRecommendation this item was added from, so the same product is never added to one cache twice"
    }
  },
  "required": [
    "cache_id",
    "item_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}