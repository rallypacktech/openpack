{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form description (up to 1000 characters)"
    },
    "audience_key": {
      "type": "string",
      "enum": [
        "general",
        "equine",
        "canine",
        "feline",
        "infant",
        "avian",
        "reptile",
        "livestock",
        "wildfire",
        "flood",
        "hurricane",
        "tornado",
        "hoa",
        "commercial_property",
        "insurance_broker",
        "fire_marshal"
      ],
      "description": "Audience key matching BusinessReferral.audience_type"
    },
    "label": {
      "type": "string",
      "description": "Display label for the audience"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "intro": {
      "type": "string",
      "description": "Intro paragraph text for the email body"
    },
    "learn_path": {
      "type": "string",
      "description": "Path for the Learn More button (e.g. /BusinessOnboarding, /equine)"
    },
    "voucher_code": {
      "type": "string",
      "description": "Promo code to include as a voucher in this email. Leave empty for no voucher."
    }
  },
  "required": [
    "audience_key",
    "label",
    "subject",
    "intro"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}