{
  "name": "OrganizationMember",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form description (up to 1000 characters)"
    },
    "subscription_id": {
      "type": "string",
      "description": "Reference to BusinessSubscription"
    },
    "location_id": {
      "type": "string",
      "description": "Reference to the OrganizationLocation this person belongs to. Empty means the whole organization."
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "description": "Primary contact address for alerts"
    },
    "business_email": {
      "type": "string",
      "description": "Work address used for the organization's business access. Distinct from the person's personal account."
    },
    "personal_email": {
      "type": "string",
      "description": "The person's personal RallyPack login. Kept separate from business access and never used for business ownership."
    },
    "phone": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "safety_officer",
        "team_lead",
        "member"
      ],
      "default": "member"
    },
    "is_org_admin": {
      "type": "boolean",
      "default": false,
      "description": "Whether this person is a designated organization admin who can manage locations and initiate ownership transfers"
    },
    "linked_user_id": {
      "type": "string",
      "description": "The RallyPack user id this member linked via their business email. Linking business access never moves their personal plans, caches or meet spots."
    },
    "department": {
      "type": "string"
    },
    "chain_of_command_order": {
      "type": "number",
      "description": "Notification order \u2014 lower number = notified first"
    },
    "notify_on_evacuation": {
      "type": "boolean",
      "default": true
    },
    "notify_on_kit_expiry": {
      "type": "boolean",
      "default": false
    },
    "notification_method": {
      "type": "string",
      "enum": [
        "email",
        "in_app",
        "both"
      ],
      "default": "email"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "pending_invite"
      ],
      "default": "pending_invite"
    }
  },
  "required": [
    "subscription_id",
    "email",
    "role"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.business_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}