{
  "name": "BusinessSubscription",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form description (up to 1000 characters)"
    },
    "organization_name": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code where the organization operates (US, CA, AU, IE, GB). Drives which fire & life safety framework and on-site checklist apply."
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the account owner"
    },
    "tier": {
      "type": "string",
      "enum": [
        "basic",
        "professional",
        "enterprise"
      ],
      "default": "basic",
      "description": "Subscription tier"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "past_due",
        "cancelled",
        "trialing"
      ],
      "default": "trialing"
    },
    "stripe_subscription_id": {
      "type": "string"
    },
    "stripe_customer_id": {
      "type": "string"
    },
    "max_first_aid_kits": {
      "type": "number",
      "default": 5,
      "description": "Max number of first aid kits tracked"
    },
    "max_members": {
      "type": "number",
      "default": 25
    },
    "alert_incidents_included": {
      "type": "number",
      "default": 0,
      "description": "Number of emergency alert incidents included per billing period (0 = not available, -1 = unlimited)"
    },
    "current_period_start": {
      "type": "string",
      "format": "date-time"
    },
    "current_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "chain_of_command_notifications": {
      "type": "boolean",
      "default": true
    },
    "evacuation_plan_enabled": {
      "type": "boolean",
      "default": true
    },
    "alert_sending_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether this subscription tier allows submitting emergency alerts for admin review"
    },
    "last_expiry_reminder_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the monthly expiration reminder email was last sent to this organization \u2014 used to dedupe to one reminder per month"
    }
  },
  "required": [
    "organization_name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}