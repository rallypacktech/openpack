{
  "name": "BusinessReferral",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-form description (up to 1000 characters)"
    },
    "referee_email": {
      "type": "string",
      "description": "Email of the business being referred"
    },
    "referee_name": {
      "type": "string",
      "description": "Contact name at the referred organization"
    },
    "organization_name": {
      "type": "string",
      "description": "Name of the referred organization"
    },
    "referrer_name": {
      "type": "string",
      "description": "Name of the person making the referral"
    },
    "referrer_email": {
      "type": "string",
      "description": "Email of the person making the referral"
    },
    "message": {
      "type": "string",
      "description": "Personal message from the referrer"
    },
    "audience_type": {
      "type": "string",
      "enum": [
        "general",
        "equine",
        "canine",
        "feline",
        "infant",
        "avian",
        "reptile",
        "livestock",
        "wildfire",
        "flood",
        "hurricane",
        "tornado",
        "hoa",
        "commercial_property",
        "insurance_broker",
        "fire_marshal"
      ],
      "default": "general",
      "description": "Species or audience type this business serves \u2014 customizes the referral email and landing page. The fire_marshal value covers all fire safety and prevention audiences; it is kept for existing records."
    },
    "state": {
      "type": "string",
      "description": "US state code (e.g. 'TX') for US referrals, or the province/region (e.g. 'Ontario', 'Karnataka') for international referrals \u2014 used for HOA, fire safety and regional tracking"
    },
    "country_code": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code for referrals outside the US (e.g. 'IN', 'IE', 'CA', 'AU', 'PK', 'SG', 'BD'). Empty for US referrals, which are tracked by state."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "contacted",
        "converted",
        "archived"
      ],
      "default": "pending",
      "description": "Processing status of the referral"
    },
    "general_email_sent": {
      "type": "boolean",
      "default": false,
      "description": "Whether the general (business) follow-up email has been sent to this referral"
    },
    "bounced": {
      "type": "boolean",
      "default": false,
      "description": "Whether email delivery to this referral bounced \u2014 flagged for cleanup so it stops triggering follow-up messages"
    }
  },
  "required": [
    "referee_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}