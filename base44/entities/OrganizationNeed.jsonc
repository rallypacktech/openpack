{
  "name": "OrganizationNeed",
  "type": "object",
  "properties": {
    "organization_name": {
      "type": "string",
      "description": "Name of the organization posting the need, or the individual's display name for personal requests"
    },
    "subscription_id": {
      "type": "string",
      "description": "Reference to the BusinessSubscription"
    },
    "posted_by_email": {
      "type": "string",
      "description": "Email of the user who posted the need"
    },
    "contact_email": {
      "type": "string",
      "description": "Contact email for organizations to reach out when claiming"
    },
    "contact_phone": {
      "type": "string",
      "description": "Optional contact phone"
    },
    "need_title": {
      "type": "string",
      "description": "Short title of the need"
    },
    "need_description": {
      "type": "string",
      "description": "Detailed description of what is needed"
    },
    "category": {
      "type": "string",
      "enum": [
        "supplies",
        "volunteers",
        "equipment",
        "space",
        "transport",
        "food",
        "medical",
        "other"
      ],
      "default": "supplies",
      "description": "Category of the need"
    },
    "species": {
      "type": "string",
      "enum": [
        "general",
        "equine",
        "canine",
        "feline",
        "infant",
        "avian",
        "reptile",
        "livestock",
        "wildfire",
        "flood",
        "hurricane",
        "tornado",
        "hoa",
        "commercial_property",
        "insurance_broker",
        "fire_safety"
      ],
      "default": "general",
      "description": "Species or audience this need serves \u2014 drives the Needs Board species filter"
    },
    "request_source": {
      "type": "string",
      "enum": [
        "organization",
        "individual"
      ],
      "default": "organization",
      "description": "Who raised the request \u2014 an organization or an individual. Individual requests only exist here when the person chose to share them with organizations."
    },
    "shared_with_organizations": {
      "type": "boolean",
      "default": true,
      "description": "For individual requests: whether the person opted to share this on the Needs Board. Individual records are only created once they opted in."
    },
    "quantity": {
      "type": "number",
      "description": "Quantity needed"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement (e.g. boxes, people, meals)"
    },
    "location": {
      "type": "string",
      "description": "Human-readable location label shown on the need card, derived from the structured location fields"
    },
    "country_name": {
      "type": "string",
      "description": "Country where the need is \u2014 top level of the location drill-down"
    },
    "admin1_name": {
      "type": "string",
      "description": "State / territory / province where the need is"
    },
    "admin2_name": {
      "type": "string",
      "description": "County / district where the need is"
    },
    "postal_code": {
      "type": "string",
      "description": "Postal code where the need is \u2014 deepest level of the location drill-down"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Urgency level of the need"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "claimed",
        "filled"
      ],
      "default": "open",
      "description": "Status of the need \u2014 open (available to claim), claimed (someone is coordinating), filled (resolved)"
    },
    "claimed_by_org": {
      "type": "string",
      "description": "Name of the organization that claimed the need"
    },
    "claimed_by_email": {
      "type": "string",
      "description": "Email of the user who claimed the need"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "filled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_name",
    "need_title",
    "need_description",
    "posted_by_email",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}