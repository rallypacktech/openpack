{
  "name": "OrganizationLocation",
  "type": "object",
  "properties": {
    "subscription_id": {
      "type": "string",
      "description": "Reference to the BusinessSubscription (the shared organization profile) this location belongs to"
    },
    "name": {
      "type": "string",
      "description": "Location name shown to staff, e.g. 'North Branch' or 'Warehouse 2'"
    },
    "location_manager_email": {
      "type": "string",
      "description": "Business email of the person who manages this location's plan and supplies"
    },
    "manager_name": {
      "type": "string",
      "description": "Name of the person who manages this location"
    },
    "phone": {
      "type": "string"
    },
    "street_address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state_province": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "country": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code where this location operates"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Inactive locations are kept for history but excluded from active management"
    }
  },
  "required": [
    "subscription_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}