{
  "description": "Sends each user a personalized email listing missing required items, expiring items, and expired items. Skips users with nothing to report. Also sends each business organization a monthly expiration summary covering kit items, AEDs, staff certifications, and fire equipment inspections.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 13 1 * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Monthly Inventory Reminder Email",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_inventory_reminder_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_personal_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendMonthlyInventoryReminder",
            "args": {}
          },
          "then": "send_business_expiry_reminders",
          "x-base44": {
            "title": "Send personal reminders",
            "description": "Missing, expiring, and expired items"
          }
        }
      },
      {
        "send_business_expiry_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendBusinessExpiryReminders",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send business expiry reminders",
            "description": "Kits, AEDs, certifications, inspections"
          }
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendMonthlyInventoryReminder"
  }
}