{
  "name": "Wildfire Season Start \u2014 EFFIS Europe Pull",
  "description": "Triggers on May 1 each year to pull fresh EFFIS wildfire history for Spain at the start of wildfire season.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 11 1 5 *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "wildfire_season_start_effis_europe_pull",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "fetchEFFISHistory",
            "args": {
              "country_code": "ES",
              "years_back": 10
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "fetchEFFISHistory"
  }
}