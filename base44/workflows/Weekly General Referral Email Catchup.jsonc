{
  "description": "Sends the general (business) referral email to any organization that never received it. Runs weekly on Thursday at 10am CT, capped at 200 emails per run \u2014 any overflow waits for the following week.",
  "name": "Weekly General Referral Email Catchup",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_general_referral_email_catchup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendGeneralEmailCatchup",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 15 * * 4",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendGeneralEmailCatchup"
  }
}